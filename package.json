{
  "name": "@fabs.ink/cli",
  "version": "0.1.0",
  "description": "Publish HTML to fabs.ink from the command line",
  "type": "module",
  "bin": {
    "fabs.ink": "./dist/cli.js",
    "fabs-ink": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build ./src/cli.ts --outfile ./dist/cli.js --target bun --minify",
    "check": "tsc --noEmit",
    "test": "bun test",
    "verify": "bun run check && bun test && bun run build",
    "prepublishOnly": "bun run verify"
  },
  "keywords": [
    "fabs.ink",
    "ink",
    "html",
    "html-document",
    "publish",
    "cli"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.3.10",
  "engines": {
    "bun": ">=1.2.0"
  },
  "dependencies": {
    "@effect/cli": "^0.77.0",
    "@effect/platform": "^0.97.1",
    "@effect/platform-bun": "^0.91.2",
    "effect": "^3.22.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
